{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@api-types": ["../../packages/api-types/index.ts"],
      "@insights-demo": ["../../packages/insights-demo/index.ts"],
      "@insights-layout": ["../../packages/insights-demo/layout.ts"]
    }
  },
  "include": ["src"]
}
