# 복사해서 .env.local 로 쓰세요 (.env.local 은 커밋되지 않음)

# 주차각 서버 주소 (apps/server). 끝의 / 는 없어도 됨
VITE_API_BASE=http://localhost:8787

# 1 이면 서버 없이 브라우저 안의 시연 데이터로 동작 (npm run dev:mock 과 같음)
# VITE_MOCK=1

# 지도 타일 주소. none 이면 타일 없이 단순 그림(SVG) 지도만 씀 (오프라인 PT용)
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> 기여자

# 0 이면 대시보드 머리글·리포트의 '시연용 예시 데이터' 표시를 끔 (서버에 실제 기록만 쌓인 뒤). 기본 켜짐
# VITE_DEMO_BADGE=0
