# release 서명 설정 — 이 파일을 keystore.properties 로 복사해 채운다 (keystore.properties 는 gitignore)
# 키 만들기 (이름·조직 칸에 실명 대신 Parkinggack — 서명 안에 그대로 남아 누구나 볼 수 있다):
#   keytool -genkeypair -v -keystore parkinggack.jks -alias parkinggack -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Parkinggack, O=Parkinggack, C=KR"
storeFile=parkinggack.jks
storePassword=
keyAlias=parkinggack
keyPassword=
